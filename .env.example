# 국회도서관 OpenAPI 인증키 — 공공데이터포털(data.go.kr) 에서 활용신청 후 발급
# ⚠️ 실제 키는 .env 에만 두고 커밋하지 마세요(.gitignore 처리됨).
#
# data.go.kr 은 인증키를 두 벌로 준다. 섞어 쓰면 이중 인코딩(%25…)으로 조용히 인증 실패한다.
#   NA_API_KEY         = 일반 인증키 **Decoding**(원문, +·/·= 포함)
#                        → requests 의 params= 로 넘길 때 사용(라이브러리가 인코딩한다).
#   NA_API_KEY_ENCODED = 일반 인증키 **Encoding**(%2B·%2F·%3D 포함)
#                        → URL 문자열에 직접 이어붙일 때만 사용.
# 하나만 넣어도 된다 — 다른 하나는 코드가 변환해서 쓴다.
NA_API_KEY=your_decoding_key_here
NA_API_KEY_ENCODED=

# 교육망·사내망 SSL 인터셉션 대응 — OS 신뢰저장소로 TLS 검증(검증을 끄지 않음).
# 1=사용(기본), 0=비활성
NA_OS_TRUST=1
