{
  "mcpServers": {
    "na": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "git+https://github.com/rubatoyd/na-openapi-mcp", "na-mcp"],
      "env": {
        "NA_API_KEY": "${NA_API_KEY:-}",
        "NA_API_KEY_ENCODED": "${NA_API_KEY_ENCODED:-}",
        "NA_OS_TRUST": "${NA_OS_TRUST:-1}"
      }
    }
  }
}
